# ============================
# MAGIC ERP - Root .gitignore
# Protects 00-DOCUMENTATION/ and all source markdown files.
# ============================

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editors
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# .NET / C# / WPF Build Artifacts
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
coverage*/
*.trx
*.coverage
*.coveragexml
AppPackages/
BundleArtifacts/

# Visual Studio / NuGet / Publish caches
*.Publish.xml
*.publishsettings
PublishScripts/
packages/

# Node.js / Angular Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
dist/
tmp/
out-tsc/
coverage/

# Local Secrets & Environment Overrides (NEVER commit secrets or keys)
.env
.env.local
.env.*.local
**/appsettings.Local.json
**/appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.pem
*.key
*.crt

# Runtime Logs & Temporary Verification Artifacts
*.log
*.dump
*.bak
