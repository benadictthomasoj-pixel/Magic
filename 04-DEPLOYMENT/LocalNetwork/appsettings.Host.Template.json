{
  "Deployment": {
    "Mode": "LocalNetwork",
    "ListenUrl": "https://0.0.0.0:5001",
    "AllowedClientSubnet": "192.168.1.0/24"
  },
  "ConnectionStrings": {
    "MagicDatabase": "Host=127.0.0.1;Port=5432;Database=magic_dev;Username=magic_app;Password=${MAGIC_DB_PASSWORD}"
  },
  "Security": {
    "Authority": "DEFERRED_OPEN_003",
    "RequireApprovedTerminalHeader": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}

