{
  "Deployment": {
    "Mode": "SingleComputer",
    "ServiceName": "MagicBackend",
    "NetworkPolicy": "StrictOnlineLan"
  },
  "Security": {
    "Authority": "DEFERRED_OPEN_003",
    "RequireApprovedTerminalHeader": false
  },
  "ConnectionStrings": {
    "MagicDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.magic.local"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/magic-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}

